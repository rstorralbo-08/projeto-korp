{
    "annotations": { "list": [] },
    "editable": true,
    "fiscalYearStartMonth": 0,
    "graphTooltip": 0,
    "id": null,
    "links": [],
    "liveNow": false,
    "panels": [
        {
            "title": "Disponibilidade do serviço",
            "type": "stat",
            "gridPos": { "h": 8, "w": 12, "x": 0, "y": 0 },
            "targets": [
                {
                    "expr": "probe_success{instance=\"http://nginx/projeto-korp\"}",                   
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "color": { "mode": "thresholds" },
                    "mappings": [
                        { "options": { "0": { "text": "Indisponível", "color": "red" }, "1": { "text": "Disponível", "color": "green" } }, "type": "value" }
                    ],
                    "thresholds": { "mode": "absolute", "steps": [ { "value": null, "color": "green" }, { "value": 0.5, "color": "red" } ] }
                },
                "overrides": []
            }
        },
        {
            "title": "Volume de Requisições HTTP",
            "type": "graph",
            "gridPos": { "h": 8, "w": 12, "x": 12, "y": 0 },
            "targets": [
                {
                    "expr": "rate(nginx_http_requests_total[1m])",
                    "refId": "A"
                }
            ],
            "fieldConfig": {
                "defaults": {
                    "unit": "reqps",
                    "custom": { "drawStyle": "line", "lineInterpolation": "linear" }
                }
            }
        }
    ],
    "refresh": "5s",
    "schemaVersion": 38,
    "style": "dark",
    "tags": [],
    "time": { "from": "now-5m", "to": "now" },
    "title": "Korp - Monitoramento",
    "uid": "korp-metrics"
}